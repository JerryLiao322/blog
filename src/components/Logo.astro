---
// 网站标志：朱红色"印章"里的 J，和 public/favicon.svg 保持一致
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true">
	<rect width="32" height="32" rx="7"></rect>
	<path
		d="M14 8.5h8M18 8.5v11.25a4.25 4.25 0 0 1-8.5 0"
		fill="none"
		stroke="#fff"
		stroke-width="3"
		stroke-linecap="round"
		stroke-linejoin="round"></path>
</svg>

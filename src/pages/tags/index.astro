---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, groupByTag } from '../../utils/posts';

const tags = groupByTag(await getPosts());
---

<BaseLayout title="标签" description="按标签浏览文章。">
	<header class="page-header">
		<h1>标签</h1>
		<p>共 {tags.length} 个标签。</p>
	</header>
	{
		tags.length > 0 ? (
			<ul class="tag-cloud">
				{tags.map(([tag, posts]) => (
					<li>
						<a href={`/tags/${tag}/`}>
							#{tag}
							<span class="count">{posts.length}</span>
						</a>
					</li>
				))}
			</ul>
		) : (
			<p class="empty">还没有标签。</p>
		)
	}
</BaseLayout>

---
// 普通页面（例如"关于"）：用 Markdown 写，开头加 layout: ../layouts/PageLayout.astro
import BaseLayout from './BaseLayout.astro';

interface Props {
	frontmatter: {
		title: string;
		description?: string;
	};
}

const { title, description } = Astro.props.frontmatter;
---

<BaseLayout title={title} description={description}>
	<header class="page-header">
		<h1>{title}</h1>
	</header>
	<div class="prose">
		<slot />
	</div>
</BaseLayout>

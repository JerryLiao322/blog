---
// 文章页：标题、日期、标签、目录、正文、上一篇/下一篇
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import TableOfContents from '../components/TableOfContents.astro';
import { formatDate, isoDate } from '../utils/date';
import { type Post, readingStats } from '../utils/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
	post: Post;
	headings: MarkdownHeading[];
	/** 时间上更早的一篇 */
	older?: Post;
	/** 时间上更新的一篇 */
	newer?: Post;
}

const { post, headings, older, newer } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, draft } = post.data;
const stats = readingStats(post.body);
---

<BaseLayout title={title} description={description || undefined} image={cover} type="article">
	<article class="post">
		<header class="post-header">
			{draft && <p class="badge">草稿 · 只在本地预览中可见，不会发布</p>}
			<h1>{title}</h1>
			<p class="post-meta">
				<time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
				<span aria-hidden="true">·</span>
				<span>{stats.words.toLocaleString('zh-CN')} 字</span>
				<span aria-hidden="true">·</span>
				<span>约 {stats.minutes} 分钟读完</span>
				{
					updatedDate && (
						<>
							<span aria-hidden="true">·</span>
							<span>
								更新于 <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time>
							</span>
						</>
					)
				}
			</p>
			{
				tags.length > 0 && (
					<ul class="tag-list">
						{tags.map((tag) => (
							<li>
								<a class="tag" href={`/tags/${tag}/`}>
									#{tag}
								</a>
							</li>
						))}
					</ul>
				)
			}
		</header>

		{cover && <Image class="post-cover" src={cover} alt="" width={1200} loading="eager" />}

		<div class="post-body">
			<TableOfContents headings={headings} />
			<div class="prose">
				<slot />
			</div>
		</div>

		{
			(older || newer) && (
				<nav class="post-nav" aria-label="更多文章">
					{older && (
						<a class="older" href={`/blog/${older.id}/`}>
							<small>← 上一篇</small>
							<span>{older.data.title}</span>
						</a>
					)}
					{newer && (
						<a class="newer" href={`/blog/${newer.id}/`}>
							<small>下一篇 →</small>
							<span>{newer.data.title}</span>
						</a>
					)}
				</nav>
			)
		}
	</article>
</BaseLayout>

<script>
	// 给每个代码块加一个"复制"按钮
	for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
		const wrapper = document.createElement('div');
		wrapper.className = 'code-block';
		pre.replaceWith(wrapper);
		wrapper.append(pre);

		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'copy-button';
		button.textContent = '复制';
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
				button.textContent = '已复制';
			} catch {
				button.textContent = '复制失败';
			}
			setTimeout(() => (button.textContent = '复制'), 1500);
		});
		wrapper.append(button);
	}
</script>
